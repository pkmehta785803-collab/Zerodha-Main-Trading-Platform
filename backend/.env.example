# Copy to .env and replace placeholders with local values. Never commit .env.
MYSQL_URL=zerodha_app:replace_with_mysql_app_password@localhost:3306/zerodha
JWT_SECRET=replace_with_a_long_random_secret
PORT=3001
CORS_ORIGINS=http://localhost:3002,http://localhost:3003,http://127.0.0.1:3002,http://127.0.0.1:3003

# Twilio SMS only. Use a newly rotated auth token.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000

# Optional: approved Twilio Content Template SID (HX...). Template must use {{1}}.
TWILIO_CONTENT_SID=your_twilio_content_template_sid
